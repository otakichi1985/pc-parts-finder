{
  "$schema": "https://schema.tauri.app/config/2",
"productName": "PC Parts Finder",
  "identifier": "jp.otakichi.pc-parts-finder",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PC Parts Finder",
        "width": 1280,
        "height": 780,
        "minWidth": 900,
        "minHeight": 650
      },
      {
        "label": "mercari-search",
        "title": "PC Parts Finder - メルカリ販売中検索",
        "url": "https://jp.mercari.com/",
        "width": 1120,
        "height": 760,
        "minWidth": 760,
        "minHeight": 540,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
